Paintbox.zip

# Review artefacts from the multi-agent audit. KNOWN-ISSUES.md carries what a
# reader actually needs; these are the raw working files, they run to hundreds
# of kilobytes, and they carry absolute paths from the machine that made them.
review-findings.json
review-findings-critic.json
review-findings-remaining.json
polish-workflow.js
fix-only-workflow.js

.DS_Store
*.log
